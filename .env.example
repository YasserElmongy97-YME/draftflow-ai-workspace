# PostgreSQL connection string (Neon or local Postgres)
DATABASE_URL="postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Google Gemini API key (server-side only, never exposed to client)
# Leave blank to run in Offline/Demo Mode
GEMINI_API_KEY=""

# Public reviewer access password; matches README and is not a private secret
DEMO_ACCESS_PASSWORD="DraftFlow-Reviewers-2026"

# Optional rate limit tuning
AI_RATE_LIMIT_MAX="10"
AI_RATE_LIMIT_WINDOW_MS="60000"
